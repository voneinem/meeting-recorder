<?xml version="1.0" encoding="utf-8"?>
<!-- Principle I: no full backup of any app data (Android 11 and lower). -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
