{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meetingrecorder.invalid/schema/meeting-1.json",
  "title": "Meeting Recorder meeting.json, schemaVersion 1",
  "description": "Metadata of one meeting folder. All positions are sample-frame indices into audio.wav (the single timeline); atMs values are derived.",
  "type": "object",
  "required": [
    "schemaVersion",
    "title",
    "startedAt",
    "status",
    "audio",
    "sources",
    "initialSourceId",
    "sourceSwitches",
    "photos",
    "dropouts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Wall-clock start with UTC offset. Informational only."
    },
    "status": { "enum": ["recording", "complete", "recovered"] },
    "audio": { "$ref": "#/$defs/audio" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "initialSourceId": { "type": "integer", "minimum": 0 },
    "sourceSwitches": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceSwitch" }
    },
    "photos": {
      "type": "array",
      "items": { "$ref": "#/$defs/photo" }
    },
    "dropouts": {
      "type": "array",
      "items": { "$ref": "#/$defs/dropout" }
    },
    "transcription": { "$ref": "#/$defs/transcription" }
  },
  "additionalProperties": true,
  "$defs": {
    "transcription": {
      "description": "Optional Phase 2 block. Meetings without it mean \"no transcription\". `transcript` describes the committed transcript, `job` the most recent run that is running or did not finish; both can exist at once (re-transcription). The folder content wins over this block. The standalone fragment is specs/002-offline-transcription/contracts/meeting-transcription.schema.json; SchemaFragmentTest keeps both in step.",
      "type": "object",
      "properties": {
        "transcript": {
          "type": "object",
          "required": [
            "modelId",
            "modelName",
            "requestedLanguage",
            "language",
            "completedAt",
            "processingMs",
            "segmentCount"
          ],
          "properties": {
            "modelId": {
              "type": "string",
              "minLength": 1
            },
            "modelName": {
              "type": "string",
              "minLength": 1
            },
            "requestedLanguage": {
              "type": "string",
              "pattern": "^(auto|[a-z]{2,3})$"
            },
            "language": {
              "type": "string",
              "pattern": "^[a-z]{2,3}$"
            },
            "completedAt": {
              "type": "string",
              "format": "date-time"
            },
            "processingMs": {
              "type": "integer",
              "minimum": 0
            },
            "segmentCount": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        "job": {
          "type": "object",
          "required": [
            "state",
            "modelId",
            "requestedLanguage",
            "startedAt"
          ],
          "properties": {
            "state": {
              "enum": [
                "in-progress",
                "failed"
              ]
            },
            "modelId": {
              "type": "string",
              "minLength": 1
            },
            "requestedLanguage": {
              "type": "string",
              "pattern": "^(auto|[a-z]{2,3})$"
            },
            "startedAt": {
              "type": "string",
              "format": "date-time"
            },
            "failureReason": {
              "enum": [
                "interrupted",
                "recording-started",
                "model-missing",
                "model-invalid",
                "out-of-memory",
                "storage-full",
                "audio-unreadable",
                "error"
              ]
            },
            "failureMessage": {
              "type": "string",
              "description": "Short English technical detail for people reading the folder; the UI shows a localized text for failureReason."
            },
            "resumable": {
              "type": "boolean",
              "description": "True when transcript.work.jsonl holds a usable checkpoint."
            }
          },
          "if": {
            "properties": {
              "state": {
                "const": "failed"
              }
            }
          },
          "then": {
            "required": [
              "failureReason"
            ]
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "audio": {
      "type": "object",
      "required": [
        "file",
        "format",
        "sampleRate",
        "channels",
        "channelLayout",
        "durationFrames",
        "durationMs"
      ],
      "properties": {
        "file": { "const": "audio.wav" },
        "format": { "const": "pcm_s16le" },
        "sampleRate": { "type": "integer", "minimum": 1 },
        "channels": { "enum": [1, 2] },
        "channelLayout": { "enum": ["mono", "stereo"] },
        "durationFrames": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["id", "name", "type", "deliveredChannels", "channels"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["builtin", "usb", "other"] },
        "deliveredChannels": { "type": "integer", "minimum": 1 },
        "channels": { "enum": [1, 2] }
      },
      "additionalProperties": true
    },
    "sourceSwitch": {
      "type": "object",
      "required": [
        "atFrame",
        "atMs",
        "fromSourceId",
        "toSourceId",
        "reason",
        "channelsDuplicated"
      ],
      "properties": {
        "atFrame": { "type": "integer", "minimum": 0 },
        "atMs": { "type": "integer", "minimum": 0 },
        "fromSourceId": { "type": "integer", "minimum": 0 },
        "toSourceId": { "type": "integer", "minimum": 0 },
        "reason": { "enum": ["device-removed"] },
        "channelsDuplicated": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "dropout": {
      "type": "object",
      "required": ["atFrame", "atMs", "droppedFrames"],
      "properties": {
        "atFrame": { "type": "integer", "minimum": 0 },
        "atMs": { "type": "integer", "minimum": 0 },
        "droppedFrames": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "photo": {
      "type": "object",
      "required": ["file", "atFrame", "atMs"],
      "properties": {
        "file": { "type": "string", "pattern": "^photos/photo-[0-9]{3,}\\.jpg$" },
        "atFrame": { "type": "integer", "minimum": 0 },
        "atMs": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    }
  }
}
